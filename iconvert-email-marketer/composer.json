{
	"require": {
		"pragmarx/ia-arr": "^7.3.3",
		"pragmarx/ia-str": "^7.3.1"
	},
	"require-dev": {
		"squizlabs/php_codesniffer": "3.13.2",
		"wp-coding-standards/wpcs": "~3.2.0",
		"phpcompatibility/phpcompatibility-wp": "~2.1.3",
		"sirbrillig/phpcs-variable-analysis": "^2.8",
		"slevomat/coding-standard": "^7.0"
	},
	"scripts": {
		"format": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcbf  --standard=phpcs.xml --report=summary,source",
		"lint": "@php ./vendor/squizlabs/php_codesniffer/bin/phpcs --standard=phpcs.xml --report=summary,source",
		"post-install-cmd": [
			"composer install --ignore-platform-reqs -d  ./pro"
		]
	},
	"config": {
		"allow-plugins": {
			"dealerdirect/phpcodesniffer-composer-installer": true
		}
	},
	"autoload": {
		"psr-4": {
			"IconvertEmailMarketer\\": "lib/src",
			"IconvertEmailMarketer\\App\\": "App/"
		}
	}
}
